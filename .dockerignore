# --- Version Control & System Files ---
.git
.gitignore
.hg
.svn
*.DS_Store
Thumbs.db

# --- Frontend ---
**/node_modules/
**/dist/
**/build/
**/.pnpm-store/
**/.yarn/
**/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

